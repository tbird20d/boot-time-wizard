class kline_class():
    def __init__(self, line, rest, index, ts_str, timestamp, delta):
        self.line = line  # full line
        self.rest = rest  # line without timestamp
        self.index = index
        self.ts_str = ts_str
        self.timestamp = timestamp
        self.delta = delta
        self.duration = 0
        self.used = False
        self.initcall = None

        self.set_match_str()
        self.id = self.match_str + " -i%s" % str(self.index)
        self.kline_match = None
        # number from 0 to 10, 0=no match
        self.match_confidence = 0

    def set_match_str(self):
        # to generate id, mask numbers and append index
        # do a series of substituions to mask numbers that might
        # change between runs (that we aren't interested in)

        # catch big numbers
        match_str = re.sub(r"0x[0-9a-fA-F]{8,}", "0XHxHxHxHx", self.rest)
        match_str = re.sub(r"[0-9]{8,}", "NnNnNnNn", match_str)
        match_str = re.sub(r"[0-9a-fA-F]{8,}", "HxHxHxHx", self.rest)

        # catch smaller numbers:
        match_str = re.sub(r"0x[0-9a-fA-F]{4,}", "0XHxHx", match_str)
        match_str = re.sub(r"[0-9]{4,}", "NnNn", match_str)

        # handle some strings specially
        if self.rest.startswith("Linux version"):
            match_str = "Linux version"

        # FIXTHIS - handle initcalls specially
        if self.rest.startswith("calling  "):
            if "+" in self.rest:
                initcall = self.rest[9:].split("+")[0]
            else:
                initcall = self.rest[9:].split(" ")[0]
            self.initcall = initcall
            match_str = "calling  " + initcall

        if self.rest.startswith("initcall "):
            if "+" in self.rest:
                initcall = self.rest[9:].split("+")[0]
            else:
                initcall = self.rest[9:].split(" ")[0]
            self.initcall = initcall
            match_str = "initcall " + initcall

        self.match_str = match_str

    def find_match(self, klines2):
        return None

def parse_kline(line):
    # returns timestamp in microseconds (int)
    ts_kline_regex = r"\[([0-9. ]+)\] (.*)"
    m = re.match(ts_kline_regex, line)
    if m:
        g = m.groups()
        ts_str = g[0]
        rest = g[1]
        try:
            timestamp = int(float(ts_str) * 1000000)
        except ValueError:
            timestamp = 0
    else:
        timestamp = 0
        rest = line

    return ts_str, timestamp, rest

# build data structures for diffing kernel message lines
# klines = map of list of klines, with kline.match_str being key
#   each value in klines is a list of msg lines that have that match_str
# kline_list = list of klines in print order
def get_klines(lines):
    klines = {}
    kline_list = []
    last_kline = None
    last_timestamp = 0
    for i in range(len(lines)):
        line = lines[i].strip()
        if not line:
            continue
        ts_str, timestamp, rest = parse_kline(line)
        if timestamp:
            delta = last_timestamp - timestamp
            last_timestamp = timestamp
        else:
            #wprint("Got a 0 timestamp on line %d: '%s" % (i, line))
            delta = 0
        kline = kline_class(line, rest, i, ts_str, timestamp, delta)
        if kline.match_str not in klines:
            klines[kline.match_str] = [kline]
        else:
            klines[kline.match_str].append(kline)
        kline_list.append(kline)
        if last_kline:
            last_kline.duration = abs(delta)
        last_kline = kline

    return (klines, kline_list)

# return the best match for kline1 out of klines2 messages
# returns (best_match, confidence)
# best_match can be None, confidence is in [0..10]
def get_best_kline_match(kline1, klines2, kline2_list):
    get_best_debug = False

    best = None
    confidence = 0

    # look for exact match on match_str
    matches = klines2.get(kline1.match_str, None)
    # matches should be sorted by index
    # find first unused one
    if matches:
        for candidate_kline in matches:
            if candidate_kline.used:
                continue
            best = candidate_kline
            confidence = 10
            return best, confidence

    # try searching whole kline2 space, with weaker match_strs
    # collect tuples (kline2, confidence)
    weak_matches = []
    no_num_match_str1 = re.sub("[0-9]","", kline1.match_str)
    early_match_str1 = no_num_match_str1[:20]
    earlier_match_str1 = early_match_str1[:10]
    first_match = False
    confidence = 0
    for kline2 in kline2_list:
        if kline2.used:
            continue
        no_num_match_str2 = re.sub("[0-9]","", kline2.match_str)
        early_match_str2 = no_num_match_str2[:20]
        earlier_match_str2 = early_match_str2[:10]
        if no_num_match_str1 == no_num_match_str2:
            if first_match:
                confidence = 9
            else:
                confidence = 8
            first_match = True
            weak_matches.append((kline2, confidence))
            continue
        if early_match_str1 == early_match_str2:
            if first_match:
                confidence = 6
            else:
                confidence = 5
            first_match = True
            weak_matches.append((kline2, confidence))
            continue
        if earlier_match_str1 == earlier_match_str2:
            if first_match:
                confidence = 3
            else:
                confidence = 2
            first_match = True
            weak_matches.append((kline2, confidence))

    # find the item with the highest confidence
    if weak_matches:
        weak_matches_sorted = sorted(weak_matches, key=itemgetter(1))
        best, confidence = weak_matches_sorted[-1]

    if get_best_debug:
        print("in get_best_kline_match")
        print(f"  {kline1.rest=}")
        print(f"  {kline1.match_str=}")
        if best:
            print(f"  {best.rest=}")
            print(f"  {best.match_str=}")
        else:
            print(f"  {best}")
        print(f"  {confidence=}")

    return best, confidence

def kmsg_show_line(kline1, kline2, index_delta, ts_delta, reason):
    debug_kmsg = False
    #debug_kmsg = True

    dmsg = ""
    delta1 = abs(float(kline1.delta) / 1000000)
    msg = kline1.rest
    # truncate msg to a fixed width
    MSG_WIDTH = 72
    if len(msg) > MSG_WIDTH:
        msg = msg[:MSG_WIDTH-2]+".."
    kline1_str = f"[{kline1.ts_str}] <{delta1:9.6f}> {msg}"
    dmsg += f"   {kline1.match_str=}\n"
    dmsg += "   line1 duration = %d\n" % kline1.duration
    dmsg += "   line1 delta = %d\n" % kline1.delta
    kline1.used = True
    if kline2:
        prefix = " "
        delta2 = abs(float(kline2.delta) / 1000000)
        pad = " " * max(100 - len(kline1_str), 1)
        suffix = f"{pad}[{kline2.ts_str}] <{delta2:9.6f}> d={ts_delta}\n"
        kline2.used = True
        dmsg += "   index delta = %d\n" % index_delta
        dmsg += "   timestamp delta = %d\n" % ts_delta
        dmsg += "   line2 duration = %d\n" % kline2.duration
        dmsg += "   line2 delta = %d\n" % kline2.delta
        dmsg += f"   {kline2.match_str=}\n"

    else:
        prefix = "-"
        suffix = "\n"

    dmsg += "   reason: %s\n" % reason
    if not debug_kmsg:
        dmsg = ""

    return prefix + kline1_str + suffix + dmsg


def diff_kmsg(bd1, bd2, desc1, desc2):
    global verbose

    lines1, lines2 = get_lines_1_2(bd1, bd2, "KERNEL MESSAGES")

    klines1, kline1_list = get_klines(lines1)
    klines2, kline2_list = get_klines(lines2)

    # build a list of output strings first, then intersperse
    #  unmatched items from klines2_list on output

    # output_tuples = [(kline1, out_str),...]
    output_tuples = []

    index_delta = 0
    last_index_delta = 0
    ts_delta = 0
    last_ts_delta = 0
    for kline1 in kline1_list:
        show_line = False
        if verbose:
            show_line = True
            reason = "debug"

        kline2, confidence = get_best_kline_match(kline1, klines2, kline2_list)
        if kline2:
            kline1.kline_match = kline2
            kline1.match_confidence = confidence
            kline2.used = True
            index_delta = kline2.index - kline1.index
            ts_delta = kline2.timestamp - kline1.timestamp

            # if lines shifted position, show them
            if index_delta != last_index_delta:
                #show_line = True
                #reason = "line shifted position"
                pass

            # if lines shifted delta by more than 5 usecs, show them
            last_index_delta = index_delta
            if abs(ts_delta != last_ts_delta) > 5:
                show_line = True
                reason = "line shifted delta"

            # if line shifted in delta, show it
            delta_delta = kline2.delta - kline1.delta
            if abs(delta_delta) > 200:
                show_line = True
                reason = "line changed delta"

            # if line shifted in duration, show it
            dur_delta = kline2.duration - kline1.duration
            if abs(dur_delta) > 200:
                show_line = True
                reason = "line changed duration"

            # other criteria?
        else:
            # show any unmatched lines
            show_line = True
            reason = "has no match"

        debug_kmsg = False
        if show_line:
            out_str = kmsg_show_line(kline1, kline2, index_delta, ts_delta, reason)
            output_tuples.append((kline1, out_str))

        # done with this kline1

    # build 'output', interspersing unused k2 lines into output_tuples
    output = ""
    i = 0
    j = 0
    k1_k2_timestamp = 0
    last_k2_timestamp = 0
    while i < len(output_tuples):
        kline1, out_str = output_tuples[i]

        # move to first unused kline2
        while j < len(kline2_list) and kline2_list[j].used:
            j += 1

        try:
            kline2 = kline2_list[j]
        except IndexError:
            kline2 = None

        # output from output_tuples or kline2_list?
        if kline1.kline_match:
            k1_k2_timestamp = kline1.kline_match.timestamp

        if kline2 and (kline2.timestamp < k1_k2_timestamp):
            # handle weirdness if the timestamps revert back in value
            # due to the early times patch
            if kline2.timestamp >= last_k2_timestamp:
                # format a '+' line with no k1 timestamp or delta data
                delta2 = abs(float(kline2.delta) / 1000000)
                msg = kline2.rest
                MSG_WIDTH=72
                if len(msg) > MSG_WIDTH:
                    msg = msg[:MSG_WIDTH-2]+".."
                part1 = f"                           {msg}"
                pad = " " * max(100 - len(part1), 1)
                part2 = f"{pad}[{kline2.ts_str}] <{delta2:9.6f}> d=n/a\n"
                out_str = "+" + part1 + part2

                last_k2_timestamp = kline2.timestamp
                #print(f"TRB: {out_str=}")
                kline2.used = True
                j += 1
            else:
                i += 1
                last_k2_timestamp = k1_k2_timestamp
        else:
            # use current out_str from output_tuples
            i += 1
            last_k2_timestamp = k1_k2_timestamp

        output += out_str
        #print(f"TRB: {out_str}", end="")

    if debug_kmsg:
        output += "some debug data:\n"

        output += "\n#######\nfile2 lines with duplicate match_strs\n"
        count_dup_match_str2 = 0
        unused_count = 0
        for klist in klines2.values():
            if len(klist) > 1:
                output += f"match_str={klist[0].match_str}\n"
                count_dup_match_str2 += 1
                for kline in klist:
                    if kline.used:

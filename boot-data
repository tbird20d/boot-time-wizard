def parse_kline(line):
    # returns timestamp in microseconds (int)
    ts_kline_regex = r"\[([0-9. ]+)\] (.*)"
    m = re.match(ts_kline_regex, line)
    if m:
        g = m.groups()
        t_str = g[0]
        rest = g[1]
        try:
            timestamp = int(float(t_str) * 1000000)
        except ValueError:
            timestamp = 0
    else:
        timestamp = 0
        rest = line

    return timestamp, rest

# build data structures for diffing kernel message lines
# klines = map of list of klines, with kline.match_str being key
#   each value in klines is a list of msg lines that have that match_str
# kline_list = list of klines in print order
def get_klines(lines):
    klines = {}
    kline_list = []
    last_kline = None
    last_timestamp = 0
    for i in range(len(lines)):
        line = lines[i].strip()
        if not line:
            continue
        timestamp, rest = parse_kline(line)
        if timestamp:
            delta = last_timestamp - timestamp
            last_timestamp = timestamp
        else:
            #wprint("Got a 0 timestamp on line %d: '%s" % (i, line))
            delta = 0
        kline = kline_class(line, rest, i, timestamp, delta)
        if kline.match_str not in klines:
            klines[kline.match_str] = [kline]
        else:
            klines[kline.match_str].append(kline)
        kline_list.append(kline)
        if last_kline:
            last_kline.duration = abs(delta)
        last_kline = kline

    return (klines, kline_list)


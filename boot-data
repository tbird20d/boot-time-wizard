# perform diff with external tool
def diff_ext(bd1, bd2, desc1, desc2, sec_name, ext_tool="diff -u"):
    global debug

    import tempfile

    lines1, lines2 = get_lines_1_2(bd1, bd2, sec_name)
    if lines1 == "**NO DATA**":
        msg = "Missing block data for section '%s' in %s file" % (sec_name, desc1)
        return msg

    if lines2 == "**NO DATA**":
        msg = "Missing block data for section '%s' in %s file" % (sec_name, desc2)
        return msg

    # write each block to a file, then process the files with the ext_tool
    block1 = "\n".join(lines1)
    block2 = "\n".join(lines2)

    with tempfile.NamedTemporaryFile(delete=False, mode="w+t", \
        encoding="utf-8", suffix=".txt") as fp1:
        fp1.write(block1)
        fp1.close()

    with tempfile.NamedTemporaryFile(delete=False, mode="w+t", \
        encoding="utf-8", suffix=".txt") as fp2:
        fp2.write(block2)
        fp2.close()

    cmd = f"{ext_tool} {fp1.name} {fp2.name}"
    (status, output) = execute_cmd(cmd)


    if desc1 and desc1 != desc2:
        output = output.replace(fp1.name, desc1)
    if desc2 and desc1 != desc2:
        output = output.replace(fp2.name, desc2)

    if debug:
        print(f"DEBUG: {fp1.name=}")
        print(f"DEBUG: {fp2.name=}")
        print("NOTICE!! - not deleting these temp files, you need to do so manually")
        print(output)
    else:
        os.unlink(fp1.name)
        os.unlink(fp2.name)

    # check for empty output (meaning no changes)
    if output.strip() == "":
        output = "** No changes **"

    return output


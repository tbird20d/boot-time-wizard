def do_top(file1, item_type, options):
    global duration_threshold
    global dur_thresh_percent
    global max_count
    global have_threshold

    bd = boot_data_parser.parse_boot_data(None, file1)

    if dur_thresh_percent:
        error_out("Invalid option (-p). Threshold percent doesn't make sense for 'top'.")

    if item_type == "initcall":
        tuples = list(bd.initcalls.items())
    elif item_type == "region":
        tuples = list(bd.regions.items())
    elif item_type == "systemd":
        tuples = list(bd.systemd_items.items())
    elif item_type == None:
        # do them all
        tuples = list(bd.initcalls.items()) \
                    + list(bd.regions.items()) \
                    + list(bd.systemd_items.items())
    else:
        error_out("Invalid item_type '%s' in do_top()" % item_type)

    if have_threshold:
        filtered_tuples = [t for t in tuples if t[1] >= duration_threshold]
        tuples = filtered_tuples

    # sort by duration (which is tuple[1])
    items = sorted(tuples, key=itemgetter(1), reverse=True)

    items = items[:max_count]

    for item, value in items:
        print(f"{item:40} = {value:8} usecs")

    sys.exit(0)


# section_prefs has the table of which diff to use per section:
# consisting of tuples like this:
#   (simple section name, section name, preferred diff method)
#
# diff methods:
#  text = text diff
#  diffconfig = diffconfig diff
#  num = numeric diff (possibly with thresholds)
#  process_diff = special process diff
#  systemd_diff = special systemd diff
#  kmsg_diff = special kernel message diff

section_prefs = {"uptime": ("UPTIME", "text"),
                 "gbd": ("GRAB-BOOT-DATA INFO", "text"),
                 "kernel": ("Kernel Info", "text"),
                 "os": ("OS", "text"),
                 "mem": ("MEMORY", "diff_mem"),
                 "disk": ("DISK USAGE", "text"),
                 "mounts": ("MOUNTS", "text"),
                 "processes": ("PROCESSES", "diff_process"),
                 "cores": ("CORES", "text"),
                 "config": ("CONFIG", "diff_config"),
                 "systemd": ("SYSTEMD INFO", "diff_systemd"),
                 "kmsg": ("KERNEL MESSAGES", "diff_kmsg"),
                 }


def do_diff(file1, file2, options):
    # output a diff of two files
    req_section = None
    if "-s" in options:
        req_section  = get_opt_with_arg('-s')

    if "-l" in options:
        sections = list(section_prefs.keys())
        sections.sort()
        print("Here are the sections you can use with 'diff':")
        for section in sections:
              print("  " + section)
        sys.exit(0)


    # outline:
    #  parse requested section
    #  validate requested section
    #  loop over sections

    # create a diff per section:
    # parse requested section name, if any
    if req_section and req_section not in section_prefs:
        error_out("Invalid section '%s' requested." % req_section)

    if req_section and not req_section == "all":
        req_sections = [req_section]
    else:
        req_sections = ["gbd", "kernel", "os", "mem", "disk", "mounts",
                        "processes", "cores", "config", "systemd", "kmsg"]

    bd1 = boot_data_parser.parse_boot_data(None, file1)
    bd2 = boot_data_parser.parse_boot_data(None, file2)

    desc1 = get_descriptor(file1)
    desc2 = get_descriptor(file2)

    for section in req_sections:
        pref = section_prefs[section]
        sec_name = pref[0]
        diff_method = pref[1]
        if diff_method == "text":
            output = diff_ext(bd1, bd2, desc1, desc2, sec_name, "diff -u")
        elif diff_method == "diff_mem":
            output = diff_mem(bd1, bd2, desc1, desc2)
        elif diff_method == "diff_process":
            output = diff_process(bd1, bd2, desc1, desc2)
        elif diff_method == "diff_config":
            output = diff_config(bd1, bd2, desc1, desc2)
        elif diff_method == "diff_systemd":
            output = diff_systemd(bd1, bd2, desc1, desc2)
        elif diff_method == "diff_kmsg":
            output = diff_kmsg(bd1, bd2, desc1, desc2)
        else:
            wprint("FIXTHIS - diff_method '%s' for section '%s' is not implemented" % (diff_method, section))

        print("== diff for section %s ==" % sec_name)
        print(output)
        print()

    sys.exit(0)

# find baseline and results files that match the indicated string
# string can contain a directory (ex: /tmp/bttw-dir/run-123456)
# if no directory specified, then just match the string.
# NOTE- string must be long enough to uniquely match one and only
# one baseline filename and one results filename.
def get_matching_files(file_match_str):
    baseline_path = None
    results_path = None

    scan_dir = os.path.dirname(file_match_str)
    if not scan_dir:
        scan_dir = "."

    match_expr = os.path.basename(file_match_str)

    for candidate in os.listdir(scan_dir):
        if match_expr in candidate:
            if "baseline" in candidate:
                if not baseline_path:
                    baseline_path = scan_dir + "/" + candidate
                else:
                    error_out("Multiple files match '%s" % file_match_str)
            if "results" in candidate:
                if not results_path:
                    results_path = scan_dir + "/" + candidate
                else:
                    error_out("Multiple files match '%s" % file_match_str)

    return baseline_path, results_path

def main():
    global debug
    global verbose
    global duration_threshold
    global max_count
    global dur_thresh_percent
    global have_threshold

    # allow error-free piping to other command line utilities (like 'head')
    signal(SIGPIPE, SIG_DFL)

    # parse command line arguments
    file1 = None
    file2 = None
    item_type = None
    # default threshold to 10ms
    duration_threshold = 10000
    max_count = 10
    file_match_str = ""

    if "-h" in sys.argv or "--help" in sys.argv:
        usage()
    if '-V' in sys.argv or '--version' in sys.argv:
        show_version()

    verbose = get_boolean_opt('-v')
    debug = get_boolean_opt('--debug')

    # flow debug setting into boot_data_parser (if needed)
    #if debug:
    #    boot_data_parser.set_debug(debug)

    if get_boolean_opt('list'):
        cmd = "list"

    if get_boolean_opt('show'):
        cmd = "show"

    if get_boolean_opt('diff'):
        cmd = "diff"

    if get_boolean_opt('compare'):
        cmd = "compare"

    if get_boolean_opt('top'):
        cmd = "top"

    if "-f" in sys.argv:
        file2 = get_opt_with_arg('-f')
        if not os.path.isfile(file2):
            error_out("'%s' is not a regular file" % file2)

    allowed_item_types = ["meta", "initcall", "region", "systemd", "config"]
    if "-t" in sys.argv:
        item_type = get_opt_with_arg('-t')
        if item_type not in allowed_item_types:
            error_out("Invalid item type. Please use one of the following: %s" % allowed_item_types)

    if "-d" in sys.argv:
        dur_str = get_opt_with_arg('-d')
        try:
            duration_threshold = int(dur_str)
        except ValueError:
            error_out("Invalid duration. Please specify an integer")
        dur_thresh_percent = 0
        have_threshold = True

    if "-c" in sys.argv:
        count_str  = get_opt_with_arg('-c')
        try:
            max_count = int(count_str)
        except ValueError:
            error_out("Invalid count. Please specify an integer")

    if "-m" in sys.argv:
        file_match_str  = get_opt_with_arg('-m')

    if "-p" in sys.argv:
        dur_str = get_opt_with_arg('-p')
        try:
            dur_thresh_percent = int(dur_str)
        except ValueError:
            error_out("Invalid duration. Please specify an integer")
        duration_threshold = 0
        have_threshold = True


    if file_match_str:
        # look for 'baseline' and 'results' files matching this string:
        file1, file2 = get_matching_files(file_match_str)

    # done with general parsable args...
    # first non-arg should be the boot data file
    if not file1:
        try:
            file1 = sys.argv[1]
            sys.argv.remove(file1)
        except IndexError:
            if cmd != "list":
                error_out("Missing boot-data file argument (use -h for help)")

    # sanity check some args
    if file1 and not os.path.isfile(file1):
        error_out("Missing or invalid boot-data file: %s" % file1)

    if cmd in ["compare", "diff"] and not file2:
        error_out("Missing second boot-data file argument\n  (use -f to specify, and -h for help)")

    options = sys.argv[1:]

    # done parsing command line
    if cmd == "list":
        do_list(file1, item_type)

    if cmd == "show":
        do_show(file1, options)

    if cmd == "top":
        do_top(file1, item_type, options)

    if cmd == "compare":
        do_compare(file1, file2, options)

    if cmd == "diff":
        do_diff(file1, file2, options)


    error_out("Unrecognized command '%s'" % cmd)

if __name__ == "__main__":
    main()

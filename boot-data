def do_show(file1, options):
    items = options

    if not items:
        error_out("Missing name of data item to show (use -h for help)")

    bd = boot_data_parser.parse_boot_data(None, file1)

    if items[0] == "all":
        items = bd.available_items()
        items.sort()

    doing_multiple = False
    if len(items) > 1:
        doing_multiple = True

    for item in items:
        value = bd.get_any(item)
        if value=="**missing**":
            error_out("Could not find '%s' in boot data file %s" % (item, file1))

        if verbose or doing_multiple:
            print(item+"=", end='')
        print(value)

    sys.exit(0)

# returns a descriptor for the filename, or the empty string
def get_descriptor(filename):
    for desc in ["baseline", "results", "ref-value"]:
        if desc in filename:
            return desc
    return ""

def get_descr_str(prefix, desc):
    if desc:
        if prefix:
            return prefix + " (" + desc + ")"
        else:
            return "(" + desc + ")"
    else:
        return prefix

# units_str should be either 's', 'ms', 'us', or if it's a word
# it should start with a space ' seconds', ' msecs', ' usecs'
def get_dir_str(delta, units_str):
    if delta > 0:
        return "increased by %d%s" % (delta, units_str)
    elif delta < 0:
        return "decreased by %d%s" % (abs(delta), units_str)
    else:
        dir_str = ""

def do_compare(file1, file2, options):
    global dur_thresh_percent
    global duration_threshold
    global have_threshold

    items = options

    if not items:
        error_out("Missing name of data item to show (use -h for help)")

    bd1 = boot_data_parser.parse_boot_data(None, file1)
    bd2 = boot_data_parser.parse_boot_data(None, file2)

    if items[0] == "all":
        items = bd1.available_items()
        items.sort()

    # try to detect baseline vs results files
    # for that, eliminate symlinks, which might mask the filenames
    rfile1 = os.path.basename(os.path.realpath(file1))
    rfile2 = os.path.basename(os.path.realpath(file2))

    desc1 = get_descriptor(file1)
    desc2 = get_descriptor(file2)

    # try to guess baseline data set
    baseline = 0
    if desc1 == "baseline":
        baseline = 1

    if desc2 == "baseline" and not baseline:
        baseline = 1

    # treat ref value as baseline if baseline is not set
    if desc1 == "ref-value" and not baseline:
        baseline = 1
    if desc2 == "ref-value" and not baseline:
        baseline = 2

    # FIXTHIS - use baseline variable somewhere??

    desc1_str = get_descr_str("", desc1)
    desc2_str = get_descr_str("", desc2)

    doing_multiple = False
    if len(items) > 1:
        doing_multiple = True

    for item in items:
        value1 = bd1.get_any(item)
        value2 = bd2.get_any(item)

        if value1 == "**missing**" and value2 == "**missing**":
            error_out("Could not find '%s' in boot data files" % item)

        # determine whether to show data and direction
        show_data = True
        delta = 0
        try:
            value1 = int(value1)
            value2 = int(value2)
            delta = value2 - value1
        except:
            # not numbers means no direction possible
            delta = 0

        dir_str = get_dir_str(delta, " usecs")

        abs_delta = abs(delta)
        if abs_delta:
            if value1:
               delta_percent = float(abs_delta)/value1
               percent_str = f" ({delta_percent:.1%})"
            else:
               #percent_str = " (bajillion%)"
               percent_str = " (NaN%)"
        else:
            precent_str = ""

        # assume we can show direction
        if delta:
            baseline_value = value1
            if dur_thresh_percent:
                threshold_delta = int((baseline_value * dur_thresh_percent) / 100)
                threshold_low = max(baseline_value - threshold_delta, 0)
                threshold_high = baseline_value + threshold_delta
            else:
                threshold_delta = duration_threshold
                threshold_low = max(baseline_value - threshold_delta, 0)
                threshold_high = baseline_value + threshold_delta

            # if thresholds are specified, check for witholding output
            if have_threshold and (value2 > threshold_low and value2 < threshold_high):
                show_data = False

        # any delta under 3 microseconds is noise, IMNSHO
        if have_threshold and abs_delta < 3:
            show_data = False

        if show_data:
            print(f"-{item} 1 {desc1_str} = {value1}")
            print(f"+{item} 2 {desc2_str} = {value2}")
            if dir_str:
                print(f"  {item} {dir_str}{percent_str}")

    sys.exit(0)


def do_top(file1, item_type, options):
    global duration_threshold
    global dur_thresh_percent
    global max_count
    global have_threshold

    bd = boot_data_parser.parse_boot_data(None, file1)

    if dur_thresh_percent:
        error_out("Invalid option (-p). Threshold percent doesn't make sense for 'top'.")

    if item_type == "initcall":
        tuples = list(bd.initcalls.items())
    elif item_type == "region":
        tuples = list(bd.regions.items())
    elif item_type == "systemd":
        tuples = list(bd.systemd_items.items())
    elif item_type == None:
        # do them all
        tuples = list(bd.initcalls.items()) \
                    + list(bd.regions.items()) \
                    + list(bd.systemd_items.items())
    else:
        error_out("Invalid item_type '%s' in do_top()" % item_type)

    if have_threshold:
        filtered_tuples = [t for t in tuples if t[1] >= duration_threshold]
        tuples = filtered_tuples

    # sort by duration (which is tuple[1])
    items = sorted(tuples, key=itemgetter(1), reverse=True)

    items = items[:max_count]

    for item, value in items:
        print(f"{item:40} = {value:8} usecs")

    sys.exit(0)


def do_show(file1, options):
    items = options

    if not items:
        error_out("Missing name of data item to show (use -h for help)")

    bd = boot_data_parser.parse_boot_data(None, file1)

    if items[0] == "all":
        items = bd.available_items()
        items.sort()

    doing_multiple = False
    if len(items) > 1:
        doing_multiple = True

    for item in items:
        value = bd.get_any(item)
        if value=="**missing**":
            error_out("Could not find '%s' in boot data file %s" % (item, file1))

        if verbose or doing_multiple:
            print(item+"=", end='')
        print(value)

    sys.exit(0)

# returns a descriptor for the filename, or the empty string
def get_descriptor(filename):
    for desc in ["baseline", "results", "ref-value"]:
        if desc in filename:
            return desc
    return ""

def get_descr_str(prefix, desc):
    if desc:
        if prefix:
            return prefix + " (" + desc + ")"
        else:
            return "(" + desc + ")"
    else:
        return prefix

# units_str should be either 's', 'ms', 'us', or if it's a word
# it should start with a space ' seconds', ' msecs', ' usecs'
def get_dir_str(delta, units_str):
    if delta > 0:
        return "increased by %d%s" % (delta, units_str)
    elif delta < 0:
        return "decreased by %d%s" % (abs(delta), units_str)
    else:
        dir_str = ""


class kline_class():
    def __init__(self, line, rest, index, timestamp, delta):
        self.line = line  # full line
        self.rest = rest  # line without timestamp
        self.index = index
        self.timestamp = timestamp
        self.delta = delta
        self.duration = 0
        self.used = False
        self.initcall = None

        self.set_match_str()
        self.id = self.match_str + " -i%s" % str(self.index)

    def set_match_str(self):
        # to generate id, mask numbers and append index
        # do a series of substituions to mask numbers that might
        # change between runs (that we aren't interested in)

        # catch big numbers
        match_str = re.sub(r"0x[0-9a-fA-F]{8,}", "0XHxHxHxHx", self.rest)
        match_str = re.sub(r"[0-9]{8,}", "NnNnNnNn", match_str)
        match_str = re.sub(r"[0-9a-fA-F]{8,}", "HxHxHxHx", self.rest)

        # catch smaller numbers:
        match_str = re.sub(r"0x[0-9a-fA-F]{4,}", "0XHxHx", match_str)
        match_str = re.sub(r"[0-9]{4,}", "NnNn", match_str)

        # handle some strings specially
        if self.rest.startswith("Linux version"):
            match_str = "Linux version"

        # FIXTHIS - handle initcalls specially

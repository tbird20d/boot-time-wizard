import sys
import os
import re
from signal import signal, SIGPIPE, SIG_DFL
import boot_data_parser

VERSION = (0,5,0)

debug = False
verbose = False

# define some defaults
dur_thresh_percent = 0
duration_threshold = 10000
have_threshold = False
max_count = 10

def eprint(msg):
    sys.stderr.write("Error: " + msg + '\n')
    sys.stderr.flush()

def error_out(msg, rcode=-1):
    eprint(msg)
    sys.exit(rcode)

def dprint(msg):
    global debug

    if debug:
        print("DEBUG: " + str(msg))

def vprint(msg):
    global verbose

    if verbose:
        print(msg)

def usage():
    print("""Usage: boot-data [<file>] <cmd> [<item>] <options>
Look up information in a boot-data file (produced by
grab-boot-data.sh), or compare information from two
boot-data files.

Specify one or more boot-data files, and possibly a data item
name, along with one of the commands below:

In general, numbers that represent durations are in micro-seconds.
(So 54000 = 54ms, and 1300000 = 1.3s)

Commands:
  list         List the boot data items that can be shown
  show         Show an individual data item with it's value
  top          Show durations above a threshhold (default 10 ms)
  compare      Compare data items in two different files
  diff         Do a time-smart diff of two boot-data files

Options:
 -h, --help    Show this usage help
 -f <file>     Use this option to specify a second file for comparison
               commands to operate on
 -d <ms>       Specify a threshold for the 'top' command, in milliseconds.
               Durations over the specified threshold will be shown
 -c <count>    Specify the max number of items to show for the 'top' command.
 -t <type>     Specify the type of items to show for the 'top' command.
               <type> can be 'initcall', 'region', 'systemd'.
 -p <percent>  Specify the duration threshold as a percent of baseline value.
               (e.g. for 10, only show values 10% different from baseline value)
 -v            Show verbose output
 --debug       Show debug information
""")
    sys.exit(0)

def show_version():
    print("boot-data - version %d.%d.%d" % VERSION)
    sys.exit(0)

# define some routines for argument handling
def get_opt_with_arg(arg):
    try:
        arg_pos = sys.argv.index(arg)
        var = sys.argv[arg_pos + 1]
        del sys.argv[arg_pos + 1]
        del sys.argv[arg_pos]
    except IndexError:
        error_out("Missing argument to '%s'. Use -h for help" % arg)

    return var

def get_boolean_opt(arg):
    if arg in sys.argv:
        sys.argv.remove(arg)
        return True
    else:
        return False

# put a wrapper around subprocess execution
# if in verbose mode,
#   output to my stdout while the subprocess is running
#   and return the empty string as output
# else use getstatusoutput to capture (and hide) the subprocess output.
# returns (status, output)
def execute(cmd, verbose=False):
    if verbose:
        try:
            result = subprocess.run(cmd, shell=True)
            status = result.returncode
            output = ""
        except subprocess.CalledProcessError as cp:
            status = cp.returncode
            output = cp.output

        return (status, output)
    else:
        return getstatusoutput(cmd)

def do_list(file1, item_type):
    global verbose

    print("""List of items (and item types) that can be shown:
== general data item types
  meta-data items
  initcalls, by function name (e.g. alsa_pcm_init)
  regions
  systemd items, by unit name (e.g. systemd-journal.service)
  config options, by name (e.g. CONFIG_BT)
""")

    if not file1:
        print("NOTE: Specify a boot-data file to see the list of items available in that file")
        sys.exit(0)

    print("== Specific data items in %s" % os.path.basename(file1))
    bd = boot_data_parser.parse_boot_data(None, file1)

    # show different data items
    if item_type == "meta" or item_type == None:
        print("Meta-data items:")
        metas = list(bd.available_metas())
        metas.sort()
        for name in metas:
            print("  " + name)

    if item_type == "initcall" or item_type == None:
        print("Initcalls:")
        ic_list = list(bd.initcalls.keys())
        ic_list.sort()
        for ic in ic_list:
            print("  " + ic)

    if item_type == "region" or item_type == None:
        print("Regions:")
        reg_list = list(bd.regions.keys())
        reg_list.sort()
        for region in reg_list:
            print("  " + region)

    if item_type == "systemd" or item_type == None:
        print("Systemd Items:")
        sd_list = list(bd.systemd_items.keys())
        sd_list.sort()
        for item in sd_list:
            print("  " + item)

    if verbose or item_type == "config":
        print("CONFIGS:")
        cname_list = list(bd.CONFIGS.keys())
        # cnames are short names (missing the 'CONFIG_' prefix)
        cname_list.sort()
        for cname in cname_list:
            print("  CONFIG_" + cname)
    else:
        if not item_type:
            print("NOTE: CONFIGS can be shown with -v (or -t config)")

    sys.exit(0)

def do_show(file1, options):
    items = options

    if not items:
        error_out("Missing name of data item to show (use -h for help)")

    bd = boot_data_parser.parse_boot_data(None, file1)

    if items[0] == "all":
        items = bd.available_items()
        items.sort()

    doing_multiple = False
    if len(items) > 1:
        doing_multiple = True

    for item in items:
        value = bd.get_any(item)
        if value=="**missing**":
            error_out("Could not find '%s' in boot data file %s" % (item, file1))

        if verbose or doing_multiple:
            print(item+"=", end='')
        print(value)

    sys.exit(0)

def do_compare(file1, file2, options):
    global dur_thresh_percent
    global duration_threshold
    global have_threshold

    items = options

    if not items:
        error_out("Missing name of data item to show (use -h for help)")

    bd1 = boot_data_parser.parse_boot_data(None, file1)
    bd2 = boot_data_parser.parse_boot_data(None, file2)

    if items[0] == "all":
        items = bd1.available_items()
        items.sort()

    # try to detect baseline vs results files
    # for that, eliminate symlinks, which might mask the filenames
    rfile1 = os.path.basename(os.path.realpath(file1))
    rfile2 = os.path.basename(os.path.realpath(file2))

    bd1_type = "unknown"
    baseline = 0
    if "baseline" in rfile1:
        bd1_type = "baseline"
        baseline = 1
    if "results" in rfile1:
        bd1_type = "results"
    if "ref-value" in rfile1:
        bd1_type = "ref value"

    bd2_type = ""
    if "baseline" in rfile2:
        bd2_type = "baseline"
        baseline = 2
    if "results" in rfile2:
        bd2_type = "results"
    if "ref-value" in rfile2:
        bd2_type = "ref value"
        if not baseline:
            baseline = 2

    # treat ref value as baseline if baseline is not set
    if bd1_type == "ref value" and not baseline:
        baseline = 1

    doing_multiple = False
    if len(items) > 1:
        doing_multiple = True

    for item in items:
        value1 = bd1.get_any(item)
        value2 = bd2.get_any(item)

        if value1 == "**missing**" and value2 == "**missing**":
            error_out("Could not find '%s' in boot data files" % item)

        # determine whether to show data and direction
        show_data = True
        delta = 0
        try:
            value1 = int(value1)
            value2 = int(value2)
            delta = value2 - value1
        except:
            # not numbers means no direction possible
            delta = 0

        if delta > 0:
            dir_str = "increased by"
        elif delta < 0:
            dir_str = "decreased by"
        else:
            dir_str = ""

        abs_delta = abs(delta)
        if abs_delta:
            if value1:
               delta_percent = float(abs_delta)/value1
               percent_str = f" ({delta_percent:.1%})"
            else:
               #percent_str = " (bajillion%)"
               percent_str = " (NaN%)"
        else:
            precent_str = ""

        # assume we can show direction
        if delta:
            baseline_value = value1
            if dur_thresh_percent:
                threshold_delta = int((baseline_value * dur_thresh_percent) / 100)
                threshold_low = max(baseline_value - threshold_delta, 0)
                threshold_high = baseline_value + threshold_delta
            else:
                threshold_delta = duration_threshold
                threshold_low = max(baseline_value - threshold_delta, 0)
                threshold_high = baseline_value + threshold_delta

            # if thresholds are specified, check for witholding output
            if have_threshold and (value2 > threshold_low and value2 < threshold_high):
                show_data = False

        # any delta under 3 microseconds is noise, IMNSHO
        if have_threshold and abs_delta < 3:
            show_data = False

        if show_data:
            print(f"{item} 1 {bd1_type} = {value1}")
            print(f"{item} 2 {bd2_type} = {value2}")
            if dir_str:
                print(f"  {item} {dir_str} {abs_delta} usecs{percent_str}")

    sys.exit(0)


def do_top(file1, item_type, options):
    global duration_threshold
    global dur_thresh_percent
    global max_count
    global have_threshold

    bd = boot_data_parser.parse_boot_data(None, file1)

    if dur_thresh_percent:
        error_out("Invalid option (-p). Threshold percent doesn't make sense for 'top'.")

    if item_type == "initcall":
        tuples = list(bd.initcalls.items())
    elif item_type == "region":
        tuples = list(bd.regions.items())
    elif item_type == "systemd":
        tuples = list(bd.systemd_items.items())
    elif item_type == None:
        # do them all
        tuples = list(bd.initcalls.items()) \
                    + list(bd.regions.items()) \
                    + list(bd.systemd_items.items())
    else:
        error_out("Invalid item_type '%s' in do_top()" % item_type)

    if have_threshold:
        filtered_tuples = [t for t in tuples if t[1] >= duration_threshold]
        tuples = filtered_tuples

    # sort by duration (which is tuple[1])
    from operator import itemgetter

    items = sorted(tuples, key=itemgetter(1), reverse=True)

    items = items[:max_count]

    for item, value in items:
        print(f"{item:40} = {value:8} usecs")

    sys.exit(0)



def diff_modules(bd1, bd2, desc1, desc2):
    #sec_name = "MODULES"

    output = ""
    mod1_names = list(bd1.modules.keys())
    if not mod1_names:
        output += "Warning: Missing data for MODULES section in file1\n"
    mod1_names.sort()
    # avoid index errors

    mod2_names = list(bd2.modules.keys())
    if not mod2_names:
        output += "Warning: Missing data for MODULES section in file2\n"
    mod2_names.sort()

    # if no data, don't show an empty table
    if (not mod1_names) and (not mod2_names):
        return output

    mod1_names.append("zzz**end**")
    mod2_names.append("zzz**end**")

    # gather data, then sort and display it (by longest duration?)
    # pick from one list, then the other, according to merge order
    i = 0
    j = 0
    output_tuples = []
    while i < len(mod1_names)-1 and j < len(mod2_names)-1:
        name1 = mod1_names[i]
        name2 = mod2_names[j]
        #print(f"{i=},{j=},{name1=},{name2=}")
        if name1 < name2:
            name = name1
            i += 1
            tuple1 = bd1.modules[name]
            if name in bd2.modules:
                tuple2 = bd2.modules[name]
            else:
                tuple2 = None

        if name1 == name2:
            name = name1
            i += 1
            j += 1
            tuple1 = bd1.modules[name]
            if name in bd2.modules:
                tuple2 = bd2.modules[name]
            else:
                tuple2 = None

        if name1 > name2:
            name = name2
            j += 1
            tuple2 = bd2.modules[name]
            if name in bd1.modules:
                tuple1 = bd1.modules[name]
            else:
                tuple1 = 0

        output_tuples.append((name, tuple1, tuple2))

    data = sorted(output_tuples, key=itemgetter(0))

    output += " Module                          Size              Used by\n"
    output += " =============================== =======           =======\n"
    for name, t1, t2 in data:
        if t1 and not t2:
            size1, usedby1 = t1
            output += "-%-30s %7s            %s" % (name, size1, usedby1)

        if not t1 and t2:
            size2, usedby2 = t2
            output += "+%-30s          %7s   %s" % (name, size2, usedby2)

        if t1 and t2:
            size1, usedby1 = t1
            size2, usedby2 = t2
            if size1 == size2:
                size_str = "%7s" % size1
            else:
                size_str = "%7s -> %s" % (size1, size2)
            if usedby1 == usedby2:
                usedby_str = usedby1
            else:
                usedby_str = "%s -> %s" % (usedby1, usedby2)
            output += " %-30s %-18s %s" % (name, size_str, usedby_str)

        output += "\n"

    return output


